{
  "name": "readx",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:rules": "firebase emulators:exec --only firestore --project demo-readx \"vitest run tests\"",
    "android": "npm run build && cap sync android && cap open android",
    "apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "deploy": "npm run build && firebase deploy --only firestore",
    "dev:emu": "firebase emulators:exec --only auth,firestore --project demo-readx --ui \"VITE_USE_EMULATORS=true vite\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-readx",
    "deploy:gh": "tsc -b && VITE_PUBLIC_SITE_URL=https://bidhanar.github.io/readx vite build --base=/readx/ --outDir ../bidhanar.github.io/readx --emptyOutDir"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@supabase/supabase-js": "^2.119.2",
    "epubjs": "^0.3.93",
    "firebase": "^12.19.0",
    "jszip": "^3.10.2",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
