# Firebase (Project settings → General → Your apps → Web app config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Supabase (Project settings → API) — used ONLY for book file storage
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: public URL of the deployed website, used to build invite links from the Android app
VITE_PUBLIC_SITE_URL=https://bidhanar.github.io/readx
